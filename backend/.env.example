GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
DATABASE_URL=sqlite:///app.db
SECRET_KEY=your-secret-key-must-be-at-least-32-characters-long-for-security
FRONTEND_URL=http://localhost:5173
OPEN_ROUTER_API_KEY=your-openrouter-api-key
OPEN_ROUTER_MODEL=openai/gpt-oss-120b:free

# OTP — dev: memory+print, prod: redis+celery (set REDIS_URL/CELERY_BROKER_URL)
OTP_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_EMAIL_BACKEND=auto
EMAIL_FROM=noreply@example.com
