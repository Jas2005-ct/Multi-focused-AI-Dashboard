# Google OAuth - DISABLED by default.
# Set ENABLE_GOOGLE_OAUTH=true (plus the client id/secret below) to re-enable
# the "Continue with Google" buttons on the login and register pages.
ENABLE_GOOGLE_OAUTH=false
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
DATABASE_URL=sqlite:///app.db
SECRET_KEY=your-secret-key-must-be-at-least-32-characters-long-for-security
# Key used to encrypt stored DB passwords (Fernet, derived via SHA256).
# MUST be stable across restarts — never reuse an ephemeral SECRET_KEY.
ENCRYPTION_KEY=your-encryption-key-must-be-at-least-32-characters-long
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MIN=60
FLASK_ENV=development
# LLM Provider Configuration ("GROQ", "OPENROUTER", or "OPEN_ZEN")
API_KEY_PROVIDER=GROQ

# Groq (default)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter
OPEN_ROUTER_API_KEY=your-openrouter-api-key
OPEN_ROUTER_MODEL=liquid/lfm-2.5-2.6b:free
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenCode Zen
OPEN_ZEN_API_KEY=your-opencode-zen-api-key
OPEN_ZEN_MODEL=minimax-m3
OPEN_ZEN_BASE_URL=https://opencode.ai/zen/v1


# OTP — dev: memory+print, prod: redis+celery (set REDIS_URL/CELERY_BROKER_URL)
OTP_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_EMAIL_BACKEND=auto
EMAIL_FROM=noreply@example.com

# Tables hidden from the table listings, the AI agent and generated SQL.
# Comma-separated, matched case-insensitively. Empty = nothing is hidden.
#   IGNORED_TABLE_PREFIXES - hides every table whose name starts with one of
#                            these prefixes, e.g. "auth_,django_"
#   IGNORED_TABLES         - hides the listed tables by exact name, e.g.
#                            "refresh_tokens,db_connections"
IGNORED_TABLE_PREFIXES=
IGNORED_TABLES=

# The shared demo database offered to visitors through the "Add demo
# database" button. It holds synthetic e-commerce data only.
#
# Empty disables the feature: the button is hidden and the endpoint
# answers 503. Point it at a database that contains nothing but demo
# data - never at the application's own database.
#
# Seed it with:  python scripts/seed_demo.py
DEMO_DB_URL=
