GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
DATABASE_URL=sqlite:///app.db
SECRET_KEY=your-secret-key-must-be-at-least-32-characters-long-for-security
FRONTEND_URL=http://localhost:5173
# LLM Provider Configuration ("OPEN_ZEN" or "OPENROUTER")
API_KEY_PROVIDER=OPEN_ZEN

# OpenRouter
OPEN_ROUTER_API_KEY=your-openrouter-api-key
OPEN_ROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenCode Zen
OPEN_ZEN_API_KEY=your-opencode-zen-api-key
OPEN_ZEN_MODEL=muse-spark-1.2-free
OPEN_ZEN_BASE_URL=https://opencode.ai/zen/v1


# OTP — dev: memory+print, prod: redis+celery (set REDIS_URL/CELERY_BROKER_URL)
OTP_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_EMAIL_BACKEND=auto
EMAIL_FROM=noreply@example.com
