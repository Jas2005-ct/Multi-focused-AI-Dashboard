# Frontend Environment Variables
VITE_API_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Backend Environment Variables
# Use PostgreSQL for production; keep sqlite only for local dev
DATABASE_URL=postgresql://user:password@db:5432/ai_dashboard
SECRET_KEY=your-secret-key-must-be-at-least-32-characters-long-for-security
ENCRYPTION_KEY=your-encryption-key-same-or-different-32-chars-min
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MIN=60
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
OPEN_ROUTER_API_KEY=your-openrouter-api-key
OPEN_ZEN_API_KEY=your-opencode-zen-api-key